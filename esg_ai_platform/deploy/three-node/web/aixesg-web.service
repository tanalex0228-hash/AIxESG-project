[Unit]
Description=AIxESG web proxy and public funnel
After=docker.service tailscaled.service network-online.target
Wants=docker.service tailscaled.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -lc 'ready=0; for i in {1..60}; do ip addr show tailscale0 | grep -q "100.125.1.6" && ready=1 && break; sleep 2; done; test "$ready" = 1; docker start aixesg_nginx; web_ready=0; for i in {1..30}; do curl -fLsS http://127.0.0.1/login/ >/dev/null 2>&1 && web_ready=1 && break; sleep 1; done; test "$web_ready" = 1; tailscale funnel --bg --yes 80'
ExecStop=/usr/bin/docker stop aixesg_nginx
TimeoutStartSec=150

[Install]
WantedBy=multi-user.target
